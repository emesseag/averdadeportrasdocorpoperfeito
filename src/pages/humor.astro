---
import AppLayout from '../layouts/AppLayout.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import MoodSelector from '../components/MoodSelector.astro';
import MoodIconSet from '../components/MoodIconSet.astro';
import RightColumn from '../components/RightColumn.astro';
---

<AppLayout title="Humor" right>
  <PageHead
    eyebrow="Humor"
    icon="smile"
    title="Como você está hoje?"
    text="Registrar o humor ajuda a perceber como você se sente ao longo dos dias. Não existe resposta certa ou errada."
  />
  <MoodSelector id="humor-page" />
  <section class="card" aria-labelledby="week-title" data-reveal>
    <h2 class="card__title" id="week-title"><Icon name="calendar" size={22} /> Sua semana</h2>
    <ul class="week-strip" data-week-strip></ul>
  </section>
  <MoodIconSet />
  <RightColumn slot="right" />
</AppLayout>
