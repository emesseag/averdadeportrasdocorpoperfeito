---
import AppLayout from '../layouts/AppLayout.astro';
import PageHead from '../components/PageHead.astro';
import GoalsCard from '../components/GoalsCard.astro';
import RightColumn from '../components/RightColumn.astro';
---

<AppLayout title="Metas" right>
  <PageHead
    eyebrow="Metas"
    icon="trending-up"
    title="Suas metas pessoais"
    text="Pequenas intenções de cuidado, no seu ritmo. Crie, conclua e remova quando quiser."
  />
  <GoalsCard id="goals-page" />
  <RightColumn slot="right" />
</AppLayout>
