---
import AppLayout from '../layouts/AppLayout.astro';
import PageHead from '../components/PageHead.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import RightColumn from '../components/RightColumn.astro';
import { posts } from '../data/posts';
import { postCategories } from '../data/categories';
---

<AppLayout title="Comunidade" right>
  <PageHead
    eyebrow="Comunidade"
    icon="users-round"
    title="Comunidade"
    text="Histórias reais, sentimentos reais e pequenas conquistas compartilhadas todos os dias."
  >
    <button type="button" class="btn btn--primary" data-open-dialog="share-dialog" aria-haspopup="dialog">
      <Icon name="pencil" size={18} /> Compartilhe algo
    </button>
  </PageHead>

  <div class="chips" data-feed-filters="community-feed" role="group" aria-label="Filtrar publicações por categoria">
    <button type="button" class="chip" data-filter="todos" aria-pressed="true">Todos</button>
    {postCategories.map((c) => <button type="button" class="chip" data-filter={c.id} aria-pressed="false">{c.plural}</button>)}
  </div>

  <div class="feed feed--list" id="community-feed" data-feed data-stagger>
    {posts.map((post) => <PostCard post={post} />)}
  </div>
  <p class="empty" data-feed-empty="community-feed" hidden>Nenhuma publicação nessa categoria ainda. Que tal ser a primeira pessoa a compartilhar?</p>

  <RightColumn slot="right" />
</AppLayout>
