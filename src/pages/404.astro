---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
---

<AppLayout title="Página não encontrada" left={false} isPublic>
  <div class="not-found">
    <Icon name="compass" size={56} strokeWidth={1.25} />
    <h1>Não encontramos essa página</h1>
    <p class="text-muted">O endereço pode ter mudado ou não existir mais. Vamos voltar para um lugar seguro?</p>
    <a class="btn btn--primary" href="/">Voltar ao início</a>
  </div>
</AppLayout>
