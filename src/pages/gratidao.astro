---
import AppLayout from '../layouts/AppLayout.astro';
import PageHead from '../components/PageHead.astro';
import GratitudeCard from '../components/GratitudeCard.astro';
import RightColumn from '../components/RightColumn.astro';
---

<AppLayout title="Gratidão" right>
  <PageHead
    eyebrow="Gratidão"
    icon="heart"
    title="Pelo que você é grato hoje?"
    text="Notar o que há de bom, mesmo nas coisas pequenas, ajuda a olhar para si e para o dia com mais carinho."
  />
  <GratitudeCard id="gratitude-page" />
  <RightColumn slot="right" />
</AppLayout>
