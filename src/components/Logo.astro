---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<a href="/" class={`logo ${className}`.trim()} aria-label="A Verdade Por Trás do Corpo Perfeito, página inicial">
  <svg class="logo__mark" viewBox="0 0 48 44" fill="none" aria-hidden="true">
    <path
      d="M24 40C10 30 4 22 4 14.5 4 8.8 8.4 4.5 14 4.5c4 0 8 2.3 10 6 2-3.7 6-6 10-6 5.6 0 10 4.3 10 10 0 7.5-6 15.5-20 25.5z"
      stroke="#171722"
      stroke-width="2.6"
      stroke-linejoin="round"></path>
    <circle cx="24" cy="17" r="4.2" stroke="#8064D9" stroke-width="2.6"></circle>
    <path d="M15.5 31c1.5-5 5-7.5 8.5-7.5s7 2.5 8.5 7.5" stroke="#8064D9" stroke-width="2.6" stroke-linecap="round"></path>
  </svg>
  <span class="logo__text" aria-hidden="true">
    <span>A Verdade</span>
    <span>Por trás do</span>
    <span>Corpo perfeito</span>
  </span>
</a>
