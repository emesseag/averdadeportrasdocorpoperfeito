---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SideNav from './SideNav.astro';
import { mainNav } from '../data/nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<dialog class="drawer" id="drawer" aria-label="Menu">
  <div class="drawer__inner">
    <div class="drawer__head">
      <Logo />
      <button type="button" class="icon-btn" data-close-dialog aria-label="Fechar menu"><Icon name="x" size={24} /></button>
    </div>
    <nav class="drawer__nav" aria-label="Menu principal">
      <p class="drawer__title">Navegação</p>
      {
        mainNav.map((item) => (
          <a class="side-link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <SideNav navLabel="Atalhos do menu" />
  </div>
</dialog>
